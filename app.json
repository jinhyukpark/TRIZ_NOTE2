{
  "expo": {
    "name": "TRIZ Note",
    "slug": "triz-note-native",
    "version": "1.0.6",
    "scheme": "triznote",
    "orientation": "default",
    "icon": "./assets/android-icon-note-brain-v6.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-mark-brain-v1.png",
      "resizeMode": "contain",
      "backgroundColor": "#020B07"
    },
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.triznote.app",
      "infoPlist": {"ITSAppUsesNonExemptEncryption": false}
    },
    "android": {
      "package": "com.triznote.app",
      "versionCode": 7,
      "icon": "./assets/android-icon-note-brain-v6.png",
      "permissions": ["com.android.vending.BILLING"],
      "adaptiveIcon": {
        "backgroundColor": "#F3F4F2",
        "foregroundImage": "./assets/android-icon-note-brain-v6.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-localization",
      "expo-web-browser",
      "expo-iap"
    ]
  }
}
